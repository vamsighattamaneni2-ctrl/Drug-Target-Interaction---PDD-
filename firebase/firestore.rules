rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public reference target proteins and approved drugs catalog
    match /reference_targets/{targetId} {
      allow read: if true;
      allow write: if false; // Read-only for standard clients; updated via admin script
    }

    match /reference_compounds/{compoundId} {
      allow read: if true;
      allow write: if false;
    }

    // User research notebooks, prediction sessions, and dockings
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /predictions/{predictionId} {
        allow read, write: if isOwner(userId);
      }

      match /screening_jobs/{jobId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
